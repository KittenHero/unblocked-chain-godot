[ext_resource type="Script" path="res://characters/transition_expression.gd" id="1_tivx7"]

[resource]
script = ExtResource("1_tivx7")
value = "(
		current_state != self
		and input.get_dual_axis(\"move_left\", \"move_right\", \"move_up\", \"move_down\") == Vector2(0, 0)
		and character.get_real_velocity() ==  character.get_platform_velocity()
)"
